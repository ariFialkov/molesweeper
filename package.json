{
  "name": "molesweeper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Molesweeper - a casual 3D minesweeper-meets-whack-a-mole stepper betting game (PWA)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "sim": "tsx scripts/simulate.ts",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
